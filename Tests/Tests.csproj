<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" Version="17.0.0" />
    <PackageReference Include="Confluent.Kafka" Version="2.16.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageReference Include="Testcontainers" Version="4.16.0" /> <!-- 4.17.0 (and WireMock.Net.Testcontainers 2.32 needing it): WireMock container start never completes under Podman -->
    <PackageReference Include="TestIdGenerator" Version="0.0.1" />
    <PackageReference Include="TUnit.Aspire" Version="1.87.12" />
    <PackageReference Include="WireMock.Net.Testcontainers" Version="2.30.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Api\Api.csproj" />
    <ProjectReference Include="..\AppHost\AppHost.csproj" Aliases="apphost" /> <!-- alias: both projects have a top-level Program -->
  </ItemGroup>

</Project>
