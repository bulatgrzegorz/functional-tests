{
  // Where the API runs: Aspire (default) | InProcess (breakpoints in the API) | Container (the published image).
  // The TESTS_API_HOST environment variable overrides this, e.g. in CI.
  "ApiHost": "Aspire",
  // Request and response bodies on the spans of the tests' API calls. TESTS_TRACE_BODIES overrides this.
  "TraceBodies": true
}
